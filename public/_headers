# Cabeçalhos aplicados também no deploy manual (arrastar a pasta no Netlify).
# O netlify.toml só é lido quando o build roda na Netlify; num deploy por
# upload direto, é este arquivo que vale.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Os assets do Next carregam hash no nome — cache permanente é seguro
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
